{
  "name": "directus-extension-sidesah",
  "description": "Logic bisnis SIDESAH: alur approval reimburse, rekening, notifikasi, sinkron Microsoft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "endpoint",
        "name": "sidesah",
        "source": "src/endpoint.ts"
      },
      {
        "type": "hook",
        "name": "sidesah-hooks",
        "source": "src/hooks.ts"
      }
    ],
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "typecheck": "tsc --noEmit",
    "test": "TZ=Asia/Jakarta vitest run"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "17.1.4",
    "@directus/types": "15.0.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "knex": "3.1.0",
    "typescript": "^5.7.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.15.1"
}
